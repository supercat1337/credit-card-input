{
    "name": "@supercat1337/credit-card-input",
    "version": "1.0.3",
    "description": "A lightweight, dependency-free credit card input formatter with automatic spacing and validation. Supports multiple card types.",
    "license": "MIT",
    "author": "supercat1337",
    "homepage": "https://github.com/supercat1337/credit-card-input",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/supercat1337/credit-card-input.git"
    },
    "type": "module",
    "main": "./dist/credit-card-input.esm.js",
    "imports": {
        "#modules/*": "./modules/*"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/credit-card-input.esm.d.ts",
                "default": "./dist/credit-card-input.esm.js"
            },
            "browser": {
                "types": "./dist/credit-card-input.esm.d.ts",
                "default": "./dist/credit-card-input.bundle.esm.js"
            }
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "scripts": {
        "clean": "shx rm -rf dist/*.d.ts dist/*.d.ts.map dist/*.js",
        "build:esm": "rollup ./src/index.js --file ./dist/credit-card-input.esm.js --format es",
        "build:bundle": "rollup ./src/index.js --file ./dist/credit-card-input.bundle.esm.js --format es -p ./node_modules/@rollup/plugin-node-resolve",
        "build:types": "tsc --project my.tsconfig.types.json",
        "build": "npm run clean && npm run build:esm && npm run build:bundle && npm run build:types",
        "test": "echo \"No tests specified\" && exit 0"
    },
    "keywords": [
        "credit-card",
        "input",
        "formatter",
        "formatting",
        "card",
        "payment",
        "validation",
        "lightweight",
        "zero-dependencies",
        "browser",
        "esm"
    ],
    "devDependencies": {
        "@rollup/plugin-node-resolve": "^15.3.1",
        "@types/node": "^25.0.10",
        "shx": "^0.4.0",
        "typescript": "^5.4.3"
    },
    "dependencies": {
        "@supercat1337/event-emitter": "^2.0.1"
    }
}
